<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="odak_menu_title" translatable="false">Odak</string>
    <string name="odak_service_label" translatable="false">Odak — dürtü anı</string>
    <string name="odak_service_description" translatable="false">Odak, seçtiğin uygulamaların ya da Reels/Shorts/Keşfet ekranının açıldığını fark eder ve önce kısa bir durdurma ekranı gösterir. Vazgeçersen Anki destelerinden birkaç kart çözersin. Ekrandaki yazılar okunmaz, kaydedilmez, hiçbir yere gönderilmez. Kararı her zaman sen verirsin: “Yine de aç” düğmesi hep oradadır.</string>
    <string name="odak_batch_label" translatable="false">Odak — toplu bildirim</string>

    <color name="odak_bg">#F6F3EC</color>

    <style name="Theme.Odak" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/odak_bg</item>
        <item name="android:navigationBarColor">@color/odak_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/odak_bg</item>
    </style>

    <style name="Theme.Odak.Gate" parent="Theme.Odak">
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
